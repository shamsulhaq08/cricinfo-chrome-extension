{
  "manifest_version": 3,
  "name": "Classic Cricket Scores",
  "version": "1.0.0",
  "description": "Classic retro cricket widget with real-time live scores, ball-by-ball commentary dismissals, and news. Unofficial fan tribute.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Classic Cricket Scores",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "classic-cricket-scores@retrocric.org",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "popup/sidepanel.html"
  },
  "sidebar_action": {
    "default_panel": "popup/sidepanel.html"
  },
  "host_permissions": [
    "https://site.api.espn.com/*",
    "https://site.web.api.espn.com/*",
    "https://www.espncricinfo.com/*",
    "https://*.espncricinfo.com/*",
    "https://p.imgci.com/*",
    "https://*.espncdn.com/*"
  ]
}
